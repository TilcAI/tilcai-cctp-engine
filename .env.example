# ── Wallets (TESTNET) ─────────────────────────────────────────────────────────
# `npm run wallets:new` genera las que falten. Para usar fondos de v52, reemplaza
# EVM_PRIVATE_KEY por la key de una wallet v52 con USDC (Fuji/Sepolia/Base).
EVM_PRIVATE_KEY=
# Solana: base58 (formato Phantom) o array JSON de 64 bytes; o SOLANA_KEYPAIR_PATH=~/.config/solana/id.json
SOLANA_PRIVATE_KEY=
# Sui: suiprivkey1... (bech32) o hex de 32 bytes
SUI_PRIVATE_KEY=
# Stellar: S...
STELLAR_SECRET_KEY=

# ── Modo sólo-lectura (opcional): direcciones públicas para `npm run balances` ──
# EVM_ADDRESS=  SOLANA_ADDRESS=  SUI_ADDRESS=  STELLAR_ADDRESS=

# ── RPCs (opcional; por defecto endpoints públicos) ───────────────────────────
# RPC_ETHEREUM_SEPOLIA=https://ethereum-sepolia-rpc.publicnode.com
# RPC_AVALANCHE_FUJI=https://api.avax-test.network/ext/bc/C/rpc
# RPC_ARBITRUM_SEPOLIA=https://sepolia-rollup.arbitrum.io/rpc
# RPC_BASE_SEPOLIA=https://sepolia.base.org
# RPC_ARC_TESTNET=https://rpc.testnet.arc.network
# RPC_SOLANA_DEVNET=https://api.devnet.solana.com
# RPC_SUI_TESTNET=https://fullnode.testnet.sui.io:443
# RPC_STELLAR_TESTNET=https://soroban-testnet.stellar.org

# ── Circle ────────────────────────────────────────────────────────────────────
# IRIS_API_URL=https://iris-api-sandbox.circle.com
# API key de testnet de Circle para el faucet programático (npm run faucet -- --usdc)
CIRCLE_API_KEY=
